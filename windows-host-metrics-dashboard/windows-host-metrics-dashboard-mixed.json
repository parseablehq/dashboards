    {
      "tile_id": "4H3HK1P0BXYC3KZZ0798FTXH83",
      "title": "CPU Utilization",
      "chartQuery": "WITH samples AS (\n  SELECT date_bin('15 seconds', time_unix_nano, '1970-01-01T00:00:00Z') AS time_bin, state,\n    data_point_value - LAG(data_point_value) OVER (PARTITION BY \"host.name\", state ORDER BY time_unix_nano) AS delta\n  FROM $metrics_dataset\n  WHERE metric_name = 'system.cpu.time'\n), utilization AS (\n  SELECT time_bin, 100.0 * (1.0 - SUM(CASE WHEN state = 'idle' AND delta >= 0 THEN delta ELSE 0 END) / NULLIF(SUM(CASE WHEN delta >= 0 THEN delta ELSE 0 END), 0)) AS cpu_used_pct\n  FROM samples WHERE delta IS NOT NULL GROUP BY time_bin\n) SELECT time_bin, ROUND(cpu_used_pct, 2) AS cpu_used_pct FROM utilization ORDER BY time_bin",
