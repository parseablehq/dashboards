    {
      "tile_id": "01M0W000000000000000000015",
      "chartQuery": "SELECT date_bin('1 minute', p_timestamp, '1970-01-01T00:00:00Z') AS time_bin, CASE WHEN data_type = 's' THEN 'Login success' WHEN data_type LIKE 'f%' THEN 'Failure' WHEN data_type IN ('ss', 'sdu') THEN 'User lifecycle' ELSE 'Other' END AS category, COUNT(DISTINCT log_id) AS events\nFROM $dataset\nGROUP BY time_bin, category\nORDER BY time_bin ASC, category ASC",
      "dbName": [
        "$dataset"
